{
  "expo": {
    "name": "GlamWithJeni",
    "slug": "glam-with-jeni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.glamwithjeni.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B2A5E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.glamwithjeni.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "GlamWithJeni",
      "shortName": "GlamWithJeni",
      "themeColor": "#5B2A5E",
      "backgroundColor": "#FCF8F9",
      "description": "Book makeup and nail art, shop press-on nails and chat with Jeni."
    },
    "scheme": "glamwithjeni",
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/glam-with-jeni"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "GlamWithJeni uses your photos so you can share nail and makeup references in chat.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
