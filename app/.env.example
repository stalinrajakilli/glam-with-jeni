# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Project settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Starter only: phone numbers (10 digits, comma-separated) that sign in as admin
# while the app runs on the in-memory store. In production the role comes from
# the profiles table instead.
EXPO_PUBLIC_ADMIN_PHONES=9999999999

# Razorpay public key id (the secret key lives only in Supabase Edge Function secrets)
EXPO_PUBLIC_RAZORPAY_KEY_ID=
